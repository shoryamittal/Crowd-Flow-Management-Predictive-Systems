# SENTINEL-AI Environment Configuration Template
# Google Cloud AI Builder Cup 2026 — Sustainability & Social Impact

# Google GenAI / Gemini API Key (Optional)
# If provided, enables live Gemini 2.0 Flash generation for Incident Copilot explanations, briefings, and translations.
# If omitted or network is offline, SENTINEL automatically uses its deterministic safety fallback engine.
GEMINI_API_KEY=

# Google Cloud Project & Region (for Vertex AI / Cloud Run)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Server & Networking
PORT=8080
HOST=0.0.0.0
SENTINEL_BIND_HOST=0.0.0.0

# Operational Sector Configuration
STATION_NAME=Prayagraj Maha Kumbh — Sector 04 (Sangam Triveni Ghat)
STATION_CODE=KUMBH-SEC-04

# Operator Authentication (Console Access)
SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASS=sentinel2026
SENTINEL_AUTH_ENABLED=true

# Persistence & Failsafe Continuity
SENTINEL_DB_PATH=data/sentinel.db
SYNC_ADAPTER_TYPE=MOCK
SYNC_ADAPTER_MODE=NORMAL
